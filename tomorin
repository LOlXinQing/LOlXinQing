        Enabled = false,
        Objects = {},
        Connections = {},
        Settings = {
            ShowBox = true,
            ShowName = true,
            ShowHealth = true,
            ShowDistance = true,
            TeamCheck = true,
            UseTeamColor = true,
            MaxDistance = 2000,
            BoxTransparency = 0.3,
            TextSize = 14
