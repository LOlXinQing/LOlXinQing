-- LOLXinQingHUB - 粉紫色卡密验证系统
-- 卡密: vdsz

local SnowEffect = nil
local SnowEnabled = false

-- 粉色飘雪效果
local function CreateSnowEffect(parent)
    if SnowEffect then
        SnowEffect:Destroy()
    end
    
    local SnowGui = Instance.new("ScreenGui")
    SnowGui.Name = "PinkSnowEffect"
    SnowGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    SnowGui.ResetOnSpawn = false
    
    -- 创建多个雪花
    local snowflakes = {}
    local function CreateSnowflake()
        local snowflake = Instance.new("Frame")
        local size = math.random(4, 12)
        snowflake.Size = UDim2.new(0, size, 0, size)
        snowflake.Position = UDim2.new(0, math.random(-100, 1200), 0, -20)
        snowflake.BackgroundColor3 = Color3.fromRGB(255, 182, 193) -- 粉红色
        snowflake.BorderSizePixel = 0
        snowflake.BackgroundTransparency = math.random(2, 8) / 10
        snowflake.Parent = SnowGui
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = snowflake
        
        table.insert(snowflakes, {
            Frame = snowflake,
            Speed = math.random(20, 60),
            Swing = math.random(1, 10),
            SwingSpeed = math.random(1, 5) / 100,
            Size = size
        })
    end
    
    -- 创建初始雪花
    for i = 1, 100 do
        CreateSnowflake()
    end
    
    -- 雪花动画
    local connection
    connection = game:GetService("RunService").RenderStepped:Connect(function(delta)
        if not SnowEnabled then
            connection:Disconnect()
            return
        end
        
        for i, snowflake in ipairs(snowflakes) do
            local currentX = snowflake.Frame.Position.X.Offset
            local currentY = snowflake.Frame.Position.Y.Offset
            
            -- 下落
            local newY = currentY + snowflake.Speed * delta
            
            -- 摆动效果
            local swingOffset = math.sin(tick() * snowflake.SwingSpeed + snowflake.Swing) * 3
            
            -- 如果雪花落到底部，重新从顶部开始
            if newY > 800 then
                newY = -20
                currentX = math.random(-100, 1200)
            end
            
            snowflake.Frame.Position = UDim2.new(0, currentX + swingOffset, 0, newY)
            
            -- 轻微旋转效果
            snowflake.Frame.Rotation = math.sin(tick() * snowflake.SwingSpeed) * 10
        end
        
        -- 偶尔添加新雪花
        if math.random(1, 15) == 1 and #snowflakes < 120 then
            CreateSnowflake()
        end
    end)
    
    SnowGui.Parent = parent
    SnowEffect = SnowGui
    SnowEnabled = true
    
    return SnowGui
end

local function RemoveSnowEffect()
    SnowEnabled = false
    if SnowEffect then
        SnowEffect:Destroy()
        SnowEffect = nil
    end
end

-- 主验证系统
local function CreateKeySystem()
    local KeySystem = {
        ValidKey = "tomorin",
        IsVerified = false
    }

    -- 创建粉紫色主题卡密验证界面
    local KeyGui = Instance.new("ScreenGui")
    KeyGui.Name = "LOLXinQingKeySystem"
    KeyGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    KeyGui.ResetOnSpawn = false

    -- 创建粉色飘雪效果
    CreateSnowEffect(KeyGui)

    -- 透明背景，确保毫无遮挡
    local BackgroundFrame = Instance.new("Frame")
    BackgroundFrame.Size = UDim2.new(1, 0, 1, 0)
    BackgroundFrame.BackgroundTransparency = 1
    BackgroundFrame.BorderSizePixel = 0
    BackgroundFrame.Parent = KeyGui

    -- 主容器
    local MainContainer = Instance.new("Frame")
    MainContainer.Size = UDim2.new(0, 480, 0, 380)
    MainContainer.Position = UDim2.new(0.5, -240, 0.5, -190)
    MainContainer.BackgroundColor3 = Color3.fromRGB(25, 10, 30)
    MainContainer.BackgroundTransparency = 0.05
    MainContainer.BorderSizePixel = 0
    MainContainer.Parent = BackgroundFrame

    -- 玻璃态效果
    local GlassEffect = Instance.new("Frame")
    GlassEffect.Size = UDim2.new(1, 0, 1, 0)
    GlassEffect.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    GlassEffect.BackgroundTransparency = 0.95
    GlassEffect.BorderSizePixel = 0
    GlassEffect.Parent = MainContainer

    -- 圆角
    local ContainerCorner = Instance.new("UICorner")
    ContainerCorner.CornerRadius = UDim.new(0, 20)
    ContainerCorner.Parent = MainContainer

    -- 粉紫色边框
    local ContainerStroke = Instance.new("UIStroke")
    ContainerStroke.Color = Color3.fromRGB(192, 132, 252)
    ContainerStroke.Thickness = 4
    ContainerStroke.Transparency = 0.2
    ContainerStroke.Parent = MainContainer

    -- 动态边框渐变
    local BorderGradient = Instance.new("UIGradient")
    BorderGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(192, 132, 252)),
        ColorSequenceKeypoint.new(0.25, Color3.fromRGB(216, 180, 254)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(232, 121, 249)),
        ColorSequenceKeypoint.new(0.75, Color3.fromRGB(217, 70, 239)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(192, 132, 252))
    })
    BorderGradient.Rotation = 45
    BorderGradient.Parent = ContainerStroke

    -- 标题区域
    local TitleFrame = Instance.new("Frame")
    TitleFrame.Size = UDim2.new(1, 0, 0, 100)
    TitleFrame.BackgroundTransparency = 1
    TitleFrame.Parent = MainContainer

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Size = UDim2.new(1, 0, 0, 60)
    TitleLabel.Position = UDim2.new(0, 0, 0, 20)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = "LOLXinQingHUB"
    TitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    TitleLabel.TextSize = 32
    TitleLabel.Font = Enum.Font.GothamBlack
    TitleLabel.TextStrokeTransparency = 0.8
    TitleLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    TitleLabel.Parent = TitleFrame

    -- 标题渐变
    local TitleGradient = Instance.new("UIGradient")
    TitleGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(232, 121, 249)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(192, 132, 252)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(217, 70, 239))
    })
    TitleGradient.Parent = TitleLabel

    local SubtitleLabel = Instance.new("TextLabel")
    SubtitleLabel.Size = UDim2.new(1, 0, 0, 30)
    SubtitleLabel.Position = UDim2.new(0, 0, 0, 70)
    SubtitleLabel.BackgroundTransparency = 1
    SubtitleLabel.Text = "qq群号为737561425"
    SubtitleLabel.TextColor3 = Color3.fromRGB(200, 180, 220)
    SubtitleLabel.TextSize = 16
    SubtitleLabel.Font = Enum.Font.Gotham
    SubtitleLabel.Parent = TitleFrame

    -- 内容区域
    local ContentFrame = Instance.new("Frame")
    ContentFrame.Size = UDim2.new(1, -60, 0, 200)
    ContentFrame.Position = UDim2.new(0, 30, 0, 120)
    ContentFrame.BackgroundTransparency = 1
    ContentFrame.Parent = MainContainer

    -- 欢迎文本
    local WelcomeLabel = Instance.new("TextLabel")
    WelcomeLabel.Size = UDim2.new(1, 0, 0, 50)
    WelcomeLabel.BackgroundTransparency = 1
    WelcomeLabel.Text = "请输入卡密进行验证"
    WelcomeLabel.TextColor3 = Color3.fromRGB(226, 232, 240)
    WelcomeLabel.TextSize = 18
    WelcomeLabel.Font = Enum.Font.Gotham
    WelcomeLabel.TextWrapped = true
    WelcomeLabel.Parent = ContentFrame

    -- 卡密输入框
    local KeyInput = Instance.new("TextBox")
    KeyInput.Size = UDim2.new(1, 0, 0, 50)
    KeyInput.Position = UDim2.new(0, 0, 0, 60)
    KeyInput.BackgroundColor3 = Color3.fromRGB(40, 25, 45)
    KeyInput.BorderSizePixel = 0
    KeyInput.PlaceholderText = "请输入卡密..."
    KeyInput.Text = ""
    KeyInput.TextColor3 = Color3.fromRGB(255, 255, 255)
    KeyInput.TextSize = 18
    KeyInput.Font = Enum.Font.Gotham
    KeyInput.PlaceholderColor3 = Color3.fromRGB(148, 163, 184)
    KeyInput.Parent = ContentFrame

    local InputCorner = Instance.new("UICorner")
    InputCorner.CornerRadius = UDim.new(0, 12)
    InputCorner.Parent = KeyInput

    local InputStroke = Instance.new("UIStroke")
    InputStroke.Color = Color3.fromRGB(192, 132, 252)
    InputStroke.Thickness = 2
    InputStroke.Transparency = 0.5
    InputStroke.Parent = KeyInput

    -- 验证按钮
    local VerifyButton = Instance.new("TextButton")
    VerifyButton.Size = UDim2.new(1, 0, 0, 60)
    VerifyButton.Position = UDim2.new(0, 0, 0, 130)
    VerifyButton.BackgroundColor3 = Color3.fromRGB(192, 132, 252)
    VerifyButton.BorderSizePixel = 0
    VerifyButton.Text = "验证卡密"
    VerifyButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    VerifyButton.TextSize = 20
    VerifyButton.Font = Enum.Font.GothamBold
    VerifyButton.Parent = ContentFrame

    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 15)
    ButtonCorner.Parent = VerifyButton

    -- 按钮渐变
    local ButtonGradient = Instance.new("UIGradient")
    ButtonGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(232, 121, 249)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(192, 132, 252))
    })
    ButtonGradient.Parent = VerifyButton

    -- 状态显示
    local StatusLabel = Instance.new("TextLabel")
    StatusLabel.Size = UDim2.new(1, 0, 0, 40)
    StatusLabel.Position = UDim2.new(0, 0, 0, 210)
    StatusLabel.BackgroundTransparency = 1
    StatusLabel.Text = "等待验证..."
    StatusLabel.TextColor3 = Color3.fromRGB(200, 180, 220)
    StatusLabel.TextSize = 14
    StatusLabel.Font = Enum.Font.Gotham
    StatusLabel.Parent = ContentFrame

    -- 动画效果
    local borderTween = game:GetService("TweenService"):Create(
        BorderGradient,
        TweenInfo.new(6, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, true),
        {Rotation = 360}
    )
    borderTween:Play()

    local titleTween = game:GetService("TweenService"):Create(
        TitleGradient,
        TweenInfo.new(4, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, true),
        {Rotation = 360}
    )
    titleTween:Play()

    -- 按钮交互效果
    VerifyButton.MouseEnter:Connect(function()
        game:GetService("TweenService"):Create(
            VerifyButton,
            TweenInfo.new(0.3),
            {Size = UDim2.new(1, 10, 0, 65)}
        ):Play()
    end)

    VerifyButton.MouseLeave:Connect(function()
        game:GetService("TweenService"):Create(
            VerifyButton,
            TweenInfo.new(0.3),
            {Size = UDim2.new(1, 0, 0, 60)}
        ):Play()
    end)

    -- 输入框焦点效果
    KeyInput.Focused:Connect(function()
        game:GetService("TweenService"):Create(
            InputStroke,
            TweenInfo.new(0.3),
            {Transparency = 0}
        ):Play()
    end)

    KeyInput.FocusLost:Connect(function()
        game:GetService("TweenService"):Create(
            InputStroke,
            TweenInfo.new(0.3),
            {Transparency = 0.5}
        ):Play()
    end)

    -- 验证功能
    VerifyButton.MouseButton1Click:Connect(function()
        local key = KeyInput.Text:gsub("%s+", ""):lower()
        
        if key == "" then
            StatusLabel.Text = "请输入卡密"
            StatusLabel.TextColor3 = Color3.fromRGB(248, 113, 113)
            return
        end

        if key == KeySystem.ValidKey then
            KeySystem.IsVerified = true
            
            StatusLabel.Text = "验证成功! 正在加载..."
            StatusLabel.TextColor3 = Color3.fromRGB(144, 238, 144)
            
            -- 成功动画
            game:GetService("TweenService"):Create(
                VerifyButton,
                TweenInfo.new(0.5),
                {BackgroundColor3 = Color3.fromRGB(144, 238, 144)}
            ):Play()
            
            KeyInput.Text = "tomorin - 已验证"
            KeyInput.TextEditable = false
            VerifyButton.Visible = false
            
            -- 加载主脚本
            delay(2, function()
                game:GetService("TweenService"):Create(
                    MainContainer,
                    TweenInfo.new(0.8),
                    {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)}
                ):Play()
                delay(0.8, function()
                    -- 移除飘雪效果
                    RemoveSnowEffect()
                    
                    -- 加载主脚本
                    local success, err = pcall(function()
                        loadstring(game:HttpGet("https://raw.githubusercontent.com/LOlXinQing/LOlXinQing/refs/heads/main/tomorin"))()
                    end)

                    if not success then
                        warn("主脚本加载失败: " .. err)
                        game:GetService("StarterGui"):SetCore("SendNotification", {
                            Title = "加载错误",
                            Text = "主脚本加载失败，请检查网络连接",
                            Duration = 5
                        })
                    end
                    
                    KeyGui:Destroy()
                end)
            end)
        else
            StatusLabel.Text = "卡密无效，请重试"
            StatusLabel.TextColor3 = Color3.fromRGB(248, 113, 113)
            
            -- 错误震动效果
            for i = 1, 3 do
                game:GetService("TweenService"):Create(
                    MainContainer,
                    TweenInfo.new(0.05),
                    {Position = UDim2.new(0.5, -240 + 5, 0.5, -190)}
                ):Play()
                wait(0.05)
                game:GetService("TweenService"):Create(
                    MainContainer,
                    TweenInfo.new(0.05),
                    {Position = UDim2.new(0.5, -240 - 5, 0.5, -190)}
                ):Play()
                wait(0.05)
            end
            game:GetService("TweenService"):Create(
                MainContainer,
                TweenInfo.new(0.1),
                {Position = UDim2.new(0.5, -240, 0.5, -190)}
            ):Play()
        end
    end)

    -- 回车键验证
    KeyInput.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            VerifyButton.MouseButton1Click()
        end
    end)

    KeyGui.Parent = game:GetService("CoreGui")
    return KeyGui
end

-- 安全执行主函数
local success, err = pcall(function()
    CreateKeySystem()
end)

if not success then
    warn("LOLXinQingHUB加载错误: " .. err)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "LOLXinQingHUB 错误",
        Text = "加载失败: " .. tostring(err),
        Duration = 5
    })
end

-- 提供手动关闭飘雪的函数
getgenv().RemoveSnow = RemoveSnowEffect
