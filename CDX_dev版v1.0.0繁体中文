function SaveSettings()
    local settings = {
        -- 通用設置
        SpeedEnabled = SpeedEnabled,
        SpeedMultiplier = SpeedMultiplier,
        JumpEnabled = JumpEnabled,
        JumpPower = JumpPower,
        FOVEnabled = FOVEnabled,
        FOVValue = FOVValue,
        WideAngleEnabled = WideAngleEnabled,
        WideAngleValue = WideAngleValue,
        
        -- ESP設置
        EspEnabled = EspEnabled,
        PlayerEspEnabled = PlayerEspEnabled,
        EnemyEspEnabled = EnemyEspEnabled,
        NpcEspEnabled = NpcEspEnabled,
        ItemEspEnabled = ItemEspEnabled,
        AntennaEspEnabled = AntennaEspEnabled,
        Box2DEspEnabled = Box2DEspEnabled,
        Box3DEspEnabled = Box3DEspEnabled,
        ArrowEspEnabled = ArrowEspEnabled,
        EspMaxDistance = EspMaxDistance,
        EspUpdateRate = EspUpdateRate,
        DotSize = DotSize
    }
    
    ConfigManager:SaveConfig("CDX_Settings", settings)
    print("設置已保存")
end

function LoadSettings()
    local settings = ConfigManager:LoadConfig("CDX_Settings")
    if settings then
        -- 加載通用設置
        SpeedToggle:SetState(settings.SpeedEnabled or false)
        SpeedSlider:SetValue(settings.SpeedMultiplier or 2)
        JumpToggle:SetState(settings.JumpEnabled or false)
        JumpSlider:SetValue(settings.JumpPower or 50)
        FOVToggle:SetState(settings.FOVEnabled or false)
        FOVSlider:SetValue(settings.FOVValue or 70)
        WideAngleToggle:SetState(settings.WideAngleEnabled or false)
        WideAngleSlider:SetValue(settings.WideAngleValue or 90)
        
        -- 加載ESP設置
        EspMainToggle:SetState(settings.EspEnabled or false)
        PlayerEspToggle:SetState(settings.PlayerEspEnabled or false)
        EnemyEspToggle:SetState(settings.EnemyEspEnabled or false)
        NpcEspToggle:SetState(settings.NpcEspEnabled or false)
        ItemEspToggle:SetState(settings.ItemEspEnabled or false)
        AntennaEspToggle:SetState(settings.AntennaEspEnabled or false)
        Box2DEspToggle:SetState(settings.Box2DEspEnabled or false)
        Box3DEspToggle:SetState(settings.Box3DEspEnabled or false)
        ArrowEspToggle:SetState(settings.ArrowEspEnabled or false)
        EspDistanceSlider:SetValue(settings.EspMaxDistance or 100)
        EspUpdateSlider:SetValue(settings.EspUpdateRate or 0.1)
        DotSizeSlider:SetValue(settings.DotSize or 30)
        
        print("設置已加載")
    end
end

