-- 更新彩色小圓點ESP（修改：替代箭頭顯示）
function UpdateArrowEsp()
    if not ArrowEspEnabled then return end
    
    local localPlayer = game.Players.LocalPlayer
    local camera = workspace.CurrentCamera
    
    for _, player in pairs(game.Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local humanoidRootPart = player.Character:FindFirstChild("HumanoidRootPart")
            if humanoidRootPart then
                local screenPoint, onScreen = camera:WorldToViewportPoint(humanoidRootPart.Position)
                local distance = CalculateDistance(camera.CFrame.Position, humanoidRootPart.Position)
                
                if distance <= EspMaxDistance then
                    if onScreen then
                        -- 創建彩色小圓點顯示
                        local dotGui = Instance.new("ScreenGui")
                        dotGui.Name = "CDX_Dot_" .. player.Name
                        dotGui.ResetOnSpawn = false
                        dotGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
                        
                        local dotFrame = Instance.new("Frame")
                        dotFrame.Name = "DotFrame"
                        dotFrame.Size = UDim2.new(0, DotSize, 0, DotSize)
                        dotFrame.Position = UDim2.new(0, screenPoint.X - DotSize/2, 0, screenPoint.Y - DotSize/2)
                        dotFrame.BackgroundTransparency = 0.3
                        dotFrame.BorderSizePixel = 0
                        
                        -- 根據隊伍設置顏色
                        if player.Team == localPlayer.Team then
                            dotFrame.BackgroundColor3 = PlayerColor
                        else
                            dotFrame.BackgroundColor3 = EnemyColor
                        end
                        
                        -- 添加圓角
                        local UICorner = Instance.new("UICorner")
                        UICorner.CornerRadius = UDim.new(1, 0)
                        UICorner.Parent = dotFrame
                        
                        -- 添加外框
                        local UIStroke = Instance.new("UIStroke")
                        UIStroke.Color = dotFrame.BackgroundColor3
                        UIStroke.Thickness = 2
                        UIStroke.Parent = dotFrame
                        
                        dotFrame.Parent = dotGui
                        dotGui.Parent = game:GetService("CoreGui")
                        
                        table.insert(EspArrows, dotGui)
                    end
                end
            end
        end
    end
end

