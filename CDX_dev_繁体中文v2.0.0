-- 將所有框架添加到顯示器
TotalPlayersFrame.Parent = PlayerCountDisplay
EnemyCountFrame.Parent = PlayerCountDisplay
TeammateCountFrame.Parent = PlayerCountDisplay
PlayerCountDisplay.Parent = game:GetService("CoreGui")

-- 更新人數顯示
function UpdatePlayerCounts()
    local players = game:GetService("Players"):GetPlayers()
    local localPlayer = game:GetService("Players").LocalPlayer
    local totalPlayers = #players
    local enemyCount = 0
    local teammateCount = 0
    
    for _, player in pairs(players) do
        if player ~= localPlayer then
            if player.Team and localPlayer.Team then
                if player.Team == localPlayer.Team then
                    teammateCount = teammateCount + 1
                else
                    enemyCount = enemyCount + 1
                end
            else
                enemyCount = enemyCount + 1
            end
        end
    end
    
    -- 更新數字顯示
    TotalPlayersLabel.Text = tostring(totalPlayers)
    EnemyCountLabel.Text = tostring(enemyCount)
    TeammateCountLabel.Text = tostring(teammateCount)
end

-- 定時更新人數
task.spawn(function()
    while true do
        task.wait(1)  -- 每1秒更新一次
        UpdatePlayerCounts()
    end
end)

-- 監聽玩家加入/離開
game:GetService("Players").PlayerAdded:Connect(function(player)
    UpdatePlayerCounts()
end)

game:GetService("Players").PlayerRemoving:Connect(function(player)
    UpdatePlayerCounts()
end)

-- 監聽隊伍變化
game:GetService("Players").LocalPlayer:GetPropertyChangedSignal("Team"):Connect(function()
    UpdatePlayerCounts()
end)

-- 初始更新人數顯示
task.spawn(function()
    task.wait(1)
    UpdatePlayerCounts()
end)

